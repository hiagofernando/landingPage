{
  "name": "rogan-locadora",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional e de conversao da ROGAN Locadora de Veiculos - Carpina/PE",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verificar": "node --import ./scripts/registrar.mjs --test scripts/regras.test.ts",
    "checar-tudo": "npm run typecheck && npm run lint && npm run verificar && npm run build",
    "formatar": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{ts,mjs}\" \"*.{json,mjs,md}\""
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}

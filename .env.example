# ============================================================================
#  ROGAN — variáveis de ambiente
# ============================================================================
#  Copie este arquivo para `.env.local` e preencha com os dados reais.
#  Tudo aqui também pode ser editado direto em `src/config/site.ts`.
#
#  Em produção o site roda em Cloudflare Workers: cadastre as mesmas
#  variáveis com `npx wrangler secret put NOME` ou no painel do Worker
#  (Settings > Variables). As que começam com NEXT_PUBLIC_ entram no HTML,
#  então nunca coloque segredo nelas.
# ============================================================================

# WhatsApp oficial da ROGAN — somente dígitos: 55 + DDD + número.
# Enquanto não for preenchido, o site usa o placeholder 5581900000000.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Como o número aparece na tela. Ex.: (81) 99999-8888
NEXT_PUBLIC_WHATSAPP_DISPLAY=

# Perfil oficial do Instagram.
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_INSTAGRAM_URL=

# Endereço da loja (Google Maps).
# `MAPS_EMBED_URL` é o src do iframe: no Google Maps, use
# Compartilhar > Incorporar um mapa > copiar HTML e pegar só a URL do src.
NEXT_PUBLIC_MAPS_EMBED_URL=
NEXT_PUBLIC_MAPS_LINK_URL=

# Domínio final do site (sem barra no fim). Usado no sitemap, no canonical
# e nas tags de compartilhamento.
NEXT_PUBLIC_SITE_URL=https://www.roganlocadora.com.br

# Faixa "Versão de demonstração" no topo do site.
# Defina como false depois de cadastrar a frota e os valores reais.
NEXT_PUBLIC_DEMO_MODE=true

# ----------------------------------------------------------------------------
#  Negociações pelo WhatsApp (selo "Em negociação")
# ----------------------------------------------------------------------------
#  Segredo compartilhado com a automação do WhatsApp (n8n). Ela manda no
#  cabeçalho `Authorization: Bearer <segredo>`, e o mesmo valor assina os
#  links "Fechar locação" / "Liberar carro" da ficha.
#
#  NÃO tem NEXT_PUBLIC_ na frente: não pode ir para o navegador.
#  Em produção: npx wrangler secret put ROGAN_API_SECRET
#  Gere um valor longo e aleatório, ex.: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ROGAN_API_SECRET=

# ----------------------------------------------------------------------------
#  Armazenamento (KV da Cloudflare)
# ----------------------------------------------------------------------------
#  Guarda as negociações e as solicitações. Precisa ser criado UMA vez:
#
#    npx wrangler kv namespace create ROGAN_KV
#
#  e então cole o id retornado em `wrangler.jsonc`, em `kv_namespaces`:
#
#    { "binding": "ROGAN_KV", "id": "<id-retornado>" }
#
#  Sem ele:
#    - negociações NÃO funcionam em produção (a rota responde 503);
#    - solicitações e eventos só aparecem em `npx wrangler tail`.
#  Em `npm run dev` um KV em memória faz as vezes dele (some ao reiniciar).
